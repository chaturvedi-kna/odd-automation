# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=odd
POSTGRES_PASSWORD=oddpassword
POSTGRES_DB=odd_automation

DATABASE_URL=postgresql+asyncpg://odd:oddpassword@db:5432/odd_automation
DATABASE_SYNC_URL=postgresql://odd:oddpassword@db:5432/odd_automation

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── ILD Engine ────────────────────────────────────────────────────────────────
PRR_NAME_MAX_LEN=16
PRR_SCOPE_SUFFIXES=s6a,s6d
RBAR_SCOPE_SUFFIXES=vdea,vpcrf

# ── Paths ─────────────────────────────────────────────────────────────────────
EXPORT_PATH=/app/exports
DUMP_INCOMING_PATH=/app/dumps/incoming
DUMP_PROCESSED_PATH=/app/dumps/processed

# ── Scheduling ────────────────────────────────────────────────────────────────
RECON_CRON_TIME=02:00
DUMP_INGEST_TIMES=06:00,18:00

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:5173

# ── Uvicorn ───────────────────────────────────────────────────────────────────
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
